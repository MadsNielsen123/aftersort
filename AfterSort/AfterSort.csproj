<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) Or $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <!-- MVVM + DI -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />

    <!-- Image decoding: SkiaSharp (raster + EXIF), Svg.Skia (SVG), Magick.NET (HEIC/HEIF) -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.14.0" />

    <!-- Video: LibVLC for thumbnails + playback. Native libs ship per-platform below;
         Linux uses the system libvlc (VideoService degrades to placeholders if absent). -->
    <PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.9.7.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1"
                     Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) Or $(RuntimeIdentifier.StartsWith('win'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1"
                     Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))) Or $(RuntimeIdentifier.StartsWith('osx'))" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Components\FolderSelectComponentView.axaml.cs">
      <DependentUpon>FolderSelectComponentView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Components\InputFolderComponentView.axaml.cs">
      <DependentUpon>InputFolderComponentView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Components\OutputFolderComponentView.axaml.cs">
      <DependentUpon>OutputFolderComponentView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
