<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:components="using:AfterSort.Views.Components"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AfterSort.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="AfterSort.Views.Pages.MainPageView"
             x:DataType="vm:MainPageViewModel"
             x:CompileBindings="True">

    <Grid ColumnDefinitions="250, *, 250">

        <!-- LEFT SIDEPANEL -->
        <Border Grid.Column="0" Background="{DynamicResource Background1}">
            <TextBlock Text="Left Sidepanel Component"
                       Foreground="{DynamicResource PrimaryText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- CENTER CONTENT PANEL -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource Background2}" Height="60">
                <TextBlock Text="Header Component"
                           Foreground="{DynamicResource PrimaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Main Content Area -->
            <Border Grid.Row="1" Background="{DynamicResource AppBackground}">
                <TextBlock Text="Welcome to the Main Page!"
                           Foreground="{DynamicResource PrimaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="24"/>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Background3}" Height="40">
                <TextBlock Text="Footer Component"
                           Foreground="{DynamicResource PrimaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- RIGHT SIDEPANEL -->
        <Border Grid.Column="2"
                Background="{DynamicResource Background1}"
                Padding="10">

            <Grid RowDefinitions="*, Auto, *">

                <!-- INPUT FOLDERS BOX -->
                <components:FolderSelectComponentView Grid.Row="0"
                    DataContext="{Binding InputFolders}"/>

                <!-- ARROW SEPARATOR -->
                <Border Grid.Row="1" Margin="0 20" HorizontalAlignment="Center" >
                    <Path Data="M0,10 L20,10 L10,20 Z"
                          Fill="{DynamicResource PrimaryText}"
                          Width="34"
                          Height="20"
                          Stretch="Uniform"/>
                </Border>

                <!-- DEST FOLDERS BOX -->
                <components:FolderSelectComponentView Grid.Row="2"
                    DataContext="{Binding DestFolders}"/>

            </Grid>
        </Border>
    </Grid>
</UserControl>