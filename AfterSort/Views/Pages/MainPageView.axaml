<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:aftersort="using:AfterSort"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AfterSort.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="AfterSort.Views.Pages.MainPageView"
             x:DataType="vm:MainPageViewModel">

    <Grid ColumnDefinitions="250, *, 250">

        <!-- LEFT SIDEPANEL -->
        <Border Grid.Column="0" Background="{DynamicResource Background1}">
            <TextBlock Text="Left Sidepanel Component"
                       Foreground="{DynamicResource PrimaryText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- CENTER CONTENT PANEL -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource Background2}" Height="60">
                <TextBlock Text="Header Component"
                           Foreground="{DynamicResource PrimaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Main Content Area -->
            <Border Grid.Row="1" Background="{DynamicResource AppBackground}">
                <TextBlock Text="Welcome to the Main Page!"
                           Foreground="{DynamicResource PrimaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="24"/>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Background3}" Height="40">
                <TextBlock Text="Footer Component"
                           Foreground="{DynamicResource PrimaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- RIGHT SIDEPANEL -->
        <Border Grid.Column="2"
                Background="{DynamicResource Background1}"
                Padding="10">

            <Grid RowDefinitions="*, Auto, *">

                <!-- INPUT FOLDERS BOX -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppBackground}" 
                        CornerRadius="2"
                        BoxShadow="{DynamicResource BoxShadow1}">

                    <Grid RowDefinitions="Auto, *, Auto">
                        <Border Grid.Row="0"
                                Background="{DynamicResource Background3}"
                                Padding="5,5,5,5"
                                Margin="0,0,0,10">

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <TextBlock Grid.Column="0"
                                   Text="Input Folders"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                                <Button Grid.Column="2" Content="Add Folder"/>
                            </Grid>

                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="5">
                            <ItemsControl ItemsSource="{Binding InputFolders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2"
                                Background="{DynamicResource Background3}"
                                Padding="5,5,5,5">

                            <Grid ColumnDefinitions="auto, auto, *, auto">

                                <Button Grid.Column="0">+</Button>
                                <Button Grid.Column="1">-</Button>
                                <Button Grid.Column="3">Folder Settings</Button>

                            </Grid>

                        </Border>

                    </Grid>
                </Border>

                <!-- ARROW SEPARATOR -->
                <Border Grid.Row="1" Margin="0 20" HorizontalAlignment="Center" >
                    <Path Data="M0,10 L20,10 L10,20 Z"
                          Fill="{DynamicResource PrimaryText}"
                          Width="34"
                          Height="20"
                          Stretch="Uniform"/>
                </Border>

                <!-- DEST FOLDERS BOX -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource AppBackground}" 
                        CornerRadius="2"
                        BoxShadow="{DynamicResource BoxShadow1}">

                    <Grid RowDefinitions="Auto, *, Auto">
                        <Border Grid.Row="0"
                                Background="{DynamicResource Background3}"
                                Padding="5,5,5,5"
                                Margin="0,0,0,10">

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <TextBlock Grid.Column="0"
                                   Text="Dest Folders"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                                <Button Grid.Column="2" Content="Add Folder"/>
                            </Grid>

                        </Border>
                    

                        <ScrollViewer Grid.Row="1" Padding="5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Folder A" Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Text="Folder B" Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Text="Folder C" Foreground="{DynamicResource PrimaryText}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2"
                                Background="{DynamicResource Background3}"
                                Padding="5,5,5,5">

                            <Grid ColumnDefinitions="auto, auto, *, auto">

                                <Button Grid.Column="0">+</Button>
                                <Button Grid.Column="1">-</Button>
                                <Button Grid.Column="3">Folder Settings</Button>

                            </Grid>

                        </Border>

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>