<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AfterSort.ViewModels.Components"
             xmlns:icons="using:AfterSort.Icons"
             mc:Ignorable="d" d:DesignWidth="230" d:DesignHeight="40"
             x:Class="AfterSort.Views.Components.InputFolderComponentView"
             x:DataType="vm:InputFolderComponentViewModel"
             x:CompileBindings="True">

    <Border Background="{DynamicResource Background2}"
            CornerRadius="4"
            Padding="8,6"
            ToolTip.Tip="{Binding FolderPath}">
        <Border.Styles>
            <Style Selector="Button.icon">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Button.icon PathIcon">
                <Setter Property="Width" Value="11"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
            <Style Selector="Button.icon:pointerover PathIcon">
                <Setter Property="Opacity" Value="1"/>
            </Style>
        </Border.Styles>

        <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto">

            <!-- Folder name (left-aligned, ellipsis on overflow) -->
            <TextBlock Grid.Column="0"
                       Text="{Binding FolderName}"
                       Foreground="{DynamicResource PrimaryText}"
                       VerticalAlignment="Center"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Progress counter n/m -->
            <TextBlock Grid.Column="1"
                       Foreground="{DynamicResource PrimaryText}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.6"
                       Margin="8,0,0,0">
                <Run Text="{Binding SortedFiles}"/><Run Text="/"/><Run Text="{Binding TotalFiles}"/>
            </TextBlock>

            <!-- Checkmark icon — uses AppIcons registry (like MudBlazor Icons.Group.Name) -->
            <PathIcon Grid.Column="2"
                      Data="{x:Static icons:AppIcons+Status.Checkmark}"
                      Foreground="{DynamicResource Success}"
                      Width="12"
                      Height="12"
                      VerticalAlignment="Center"
                      Margin="6,0,0,0"
                      IsVisible="{Binding IsCompleted}"/>

            <!-- Folder settings -->
            <Button Grid.Column="3"
                    Classes="icon"
                    ToolTip.Tip="Folder settings">
                <PathIcon Data="{x:Static icons:AppIcons+Action.Settings}"/>
            </Button>

            <!-- Remove folder -->
            <Button Grid.Column="4"
                    Classes="icon"
                    Command="{Binding RemoveCommand}"
                    ToolTip.Tip="Remove folder">
                <PathIcon Data="{x:Static icons:AppIcons+Action.Close}"/>
            </Button>

        </Grid>
    </Border>
</UserControl>
