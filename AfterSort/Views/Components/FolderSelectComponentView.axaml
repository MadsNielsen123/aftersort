<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AfterSort.ViewModels.Components"
             mc:Ignorable="d" d:DesignWidth="230" d:DesignHeight="40"
             x:Class="AfterSort.Views.Components.FolderSelectComponentView"
             x:DataType="vm:FolderSelectComponentViewModel"
             x:CompileBindings="True">

    <Border Background="{DynamicResource AppBackground}"
            CornerRadius="2"
            BoxShadow="{DynamicResource BoxShadow1}">

        <Grid RowDefinitions="Auto, *">
            <Border Grid.Row="0"
                    Background="{DynamicResource Background3}"
                    Padding="5">

                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource PrimaryText}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

            </Border>

            <!-- Folders, followed by the "add folder" skeleton tile. The tile carries its own top
                 margin only when folders precede it, so on an empty list it lands exactly where the
                 first folder will. -->
            <ScrollViewer Grid.Row="1" Margin="5" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <ItemsControl ItemsSource="{Binding Items}"
                                  IsVisible="{Binding HasItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button Command="{Binding AddItemCommand}"
                            Classes.stacked="{Binding HasItems}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip.Tip="Add folder">
                        <Button.Styles>
                            <Style Selector="Button.stacked">
                                <Setter Property="Margin" Value="0,5,0,0"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Button.Styles>
                        <Border Background="{DynamicResource Background2}"
                                CornerRadius="4"
                                Height="32">
                            <TextBlock Text="+"
                                       Foreground="{DynamicResource PrimaryText}"
                                       Opacity="0.5"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Button>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
