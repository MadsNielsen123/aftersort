<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AfterSort.App"
             xmlns:local="using:AfterSort"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AfterSort/Themes/BaseColors.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Dark" Source="avares://AfterSort/Themes/DarkOverrides.axaml" />
                
                <ResourceInclude x:Key="{x:Static local:App.GreyTheme}" Source="avares://AfterSort/Themes/GreyOverrides.axaml" />
            </ResourceDictionary.ThemeDictionaries>
            
        </ResourceDictionary>
    </Application.Resources>

</Application>