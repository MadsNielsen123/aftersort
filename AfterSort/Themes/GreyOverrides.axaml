<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="AppBackground" Color="#2c2c2c" />
    <SolidColorBrush x:Key="Background1" Color="#363636" />
    <SolidColorBrush x:Key="Background2" Color="#404040" />
    <SolidColorBrush x:Key="Background3" Color="#4a4a4a" />
    <SolidColorBrush x:Key="Background4" Color="#555555" />
    <SolidColorBrush x:Key="Background5" Color="#606060" />

    <SolidColorBrush x:Key="PrimaryText" Color="#e0e0e0" />
    <SolidColorBrush x:Key="SecondaryText" Color="#2c2c2c" />

    <SolidColorBrush x:Key="Error" Color="#E53935" />
    <SolidColorBrush x:Key="Success" Color="#4CAF50" />

    <BoxShadows x:Key="BoxShadow1">0 4 10 0 #1a1a1a</BoxShadows>

</ResourceDictionary>